# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/tche_satsuma"

# Authentication
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Email Configuration (SendGrid example)
EMAIL_FROM="noreply@tchesatsuma.org"
SENDGRID_API_KEY="your-sendgrid-api-key"

# WhatsApp Configuration (Twilio example)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# File Storage (AWS S3 example)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="tche-satsuma-uploads"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Feature Flags
NEXT_PUBLIC_ENABLE_WHATSAPP="false"
NEXT_PUBLIC_ENABLE_PAYMENTS="false"

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=""

# Environment
NODE_ENV="development"
